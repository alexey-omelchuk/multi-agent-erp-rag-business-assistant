# Copia este archivo como ".env" y rellena los valores.
# ".env" nunca se sube al repositorio; este archivo si.

# --- Modelo de lenguaje ---
# Formato "proveedor:modelo". Ejemplos:
#   openai:gpt-5.6-luna          (necesita OPENAI_API_KEY)
#   azure_openai:gpt-5.6-luna    (necesita las variables AZURE_OPENAI_*)
#   anthropic:claude-haiku-4-5   (necesita ANTHROPIC_API_KEY)
MODEL=openai:gpt-5.6-luna

# Temperatura del modelo. Dejala comentada con modelos de razonamiento (usan la suya).
# MODEL_TEMPERATURE=0

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Nombre del deployment en Azure (si se deja vacio, se usa el nombre de MODEL)
AZURE_OPENAI_MODEL_DEPLOYMENT_NAME=gpt-5.6-luna

# Anthropic
ANTHROPIC_API_KEY=

# --- Fuentes de datos ---
NORTHWIND_DB_PATH=data/northwind.db
PRODUCTION_API_URL=http://localhost:8001
# URL de la API principal, para la interfaz de chat
API_URL=http://localhost:8000
PRODUCTION_DATA_PATH=data/production_orders.json
CHROMA_DIR=chroma

# --- RAG (documentos) ---
# Modelo de embeddings local (fastembed). No necesita clave de API.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.4

# --- Docker Compose ---
# Hace que "docker compose up -d" levante la aplicacion y Langfuse a la vez.
# Comenta esta linea para arrancar sin Langfuse (ahorra unos 4 GB de RAM).
COMPOSE_FILE=docker-compose.yml:docker-compose.langfuse.yml

# --- Langfuse ---
# Con docker-compose.langfuse.yml no hace falta tocar nada: estas son las
# claves que se crean solas. Cambialas si expones Langfuse fuera de tu equipo.
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=langfuse-local

# --- Comportamiento ---
# Llamadas a tools por consulta: cada subagente (por encargo) y el coordinador
AGENT_MAX_TOOL_CALLS=10
COORDINATOR_MAX_TOOL_CALLS=8
MEMORY_MAX_INTERACTIONS=5
LOG_LEVEL=INFO
